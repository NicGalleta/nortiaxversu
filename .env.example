# Copy to .env.local. Find these values in Supabase > Project Settings > API.
# Public browser configuration (embedded by Vite at build time).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Worker runtime configuration: use the SAME project URL and publishable key.
# Cloudflare's Vite plugin loads these from .env.local during local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# A legacy anon key also works in the *_PUBLISHABLE_KEY variables.
# Never put a secret/service_role key in any of these variables.
# No privileged key is needed for login or the read-only dashboard.

# Phase 3 imports only. Server-only privileged key; NEVER prefix with VITE_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Phase 6, Worker-only AI configuration. Manual analysis needs none of these.
AI_ENABLED=false
AI_GATEWAY_ID=nortia-analista
# Set once at launch to launch + 14 days, explicit UTC ISO timestamp.
# Empty or expired = AI disabled. Do not extend on redeploy.
AI_DEMO_END=
